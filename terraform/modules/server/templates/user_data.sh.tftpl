#!/bin/bash
# Minimal bootstrap executed by EC2 user-data.
# Everything else (Java, Jenkins, Docker, Trivy) is installed by Ansible.
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y --no-install-recommends \
  python3 \
  python3-apt \
  python3-pip \
  openssh-server \
  ca-certificates \
  curl \
  git \
  unzip \
  sudo

# Ansible connects as root on the emulated/real instance.
mkdir -p /root/.ssh
chmod 700 /root/.ssh

# Make sure the SSH service is up on images without systemd as PID 1.
if ! pgrep -x sshd >/dev/null 2>&1; then
  mkdir -p /run/sshd
  /usr/sbin/sshd
fi

echo "Bootstrap for ${jenkins_admin_user} finished" > /var/log/ivolve-bootstrap.log
